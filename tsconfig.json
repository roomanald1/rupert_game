    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ESNext",
    "outDir": "dist",
    "rootDir": "src",
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  }, 
  "exclude": ["rspack.config.mjs"],
  "include": ["src/**/*"],

}